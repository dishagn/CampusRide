# ==============================================================================
# CAMPUS RIDE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and populate your project credentials.
# Do NOT commit your actual .env file with secrets into version control.

# Supabase Project Configuration (Obtain from your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# College Campus Location & Geofence (Defaults: Bangalore Campus)
VITE_CAMPUS_LATITUDE=12.9716
VITE_CAMPUS_LONGITUDE=77.5946
VITE_CAMPUS_GEOFENCE_RADIUS_METERS=200

# OSRM Routing Endpoint (Default: Public demo server; can be swapped with self-hosted instance)
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org

# Tile Server URL (Default: OpenStreetMap tile server)
VITE_TILE_SERVER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
